<?xml version="1.0"?>
<!--
  LOCAL DEV ONLY. Shared by the three servers of docker-compose.replicas.yml: the standalone Keeper,
  the interserver port replicas fetch parts over, and the server settings docs/clickhouse-replication.md
  recommends. Each server's own macros come from its MACRO_REPLICA environment variable.
-->
<clickhouse>
    <zookeeper>
        <node>
            <host>keeper</host>
            <port>9181</port>
        </node>
    </zookeeper>
    <interserver_http_port>9009</interserver_http_port>
    <macros>
        <shard>01</shard>
        <replica from_env="MACRO_REPLICA"/>
    </macros>
    <merge_tree>
        <execute_merges_on_single_replica_time_threshold>1800</execute_merges_on_single_replica_time_threshold>
        <wait_for_unique_parts_send_before_shutdown_ms>60000</wait_for_unique_parts_send_before_shutdown_ms>
    </merge_tree>
</clickhouse>
