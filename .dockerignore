# The Dockerfile copies only build.gradle, settings.gradle, gradle.properties, checkstyle/, src/ and
# docker-entrypoint.sh. Everything below is excluded from the build context so nothing else can reach a layer.

# VCS
.git
.gitattributes
.github
.hg

# Build output and Gradle state
.gradle
build/
out/
bin/
target/
dist/

# IDE and editor configuration
.idea
*.iml
*.ipr
*.iws
.vscode/
.run
.settings
.project
.classpath
.factorypath
.sts4-cache
*.swp
*~
.DS_Store
**/.DS_Store

# Local credentials and secrets
.env
.env.*
*.env
*.pem
*.key
*.p12
*.jks
*.keystore
*.crt

# Logs and temporary files
*.log
logs/
tmp/
*.tmp
ai.tmp.json

# Agent, docs and local tooling not needed by the image
.claude
openspec/
docs/
local_env/
grafana/
*.md
.ort.yml
trivy.yaml
