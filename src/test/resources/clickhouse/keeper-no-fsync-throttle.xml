<?xml version="1.0"?>
<!--
  A throwaway Keeper: every Keeper write otherwise waits out the fsync throttle, and a replicated DDL makes a dozen or
  more of them in sequence. Durability does not matter to the suite. Merged over clickhouse/keeper.xml and
  clickhouse/replicas/keeper.xml only from ClickHouse 26.x (ClickHouseTestVersion): 25.x has no throttle and refuses
  the setting as unknown.
-->
<clickhouse>
    <keeper_server>
        <coordination_settings>
            <min_time_between_fsyncs_ms>0</min_time_between_fsyncs_ms>
        </coordination_settings>
    </keeper_server>
</clickhouse>
